# Copy to .env and fill in. .env is gitignored and must never be committed.

# Which backend to use: ollama (local, no key needed) or openai
LLM_PROVIDER=ollama

# --- Ollama (local) ---
# Must be a model that supports tool calling. Good choices: llama3.1,
# qwen2.5, mistral-nemo. Small models like llama3.2:1b are unreliable at
# tool calls and will produce confusing failures that look like bugs in
# your code.
OLLAMA_MODEL=llama3.1

# --- OpenAI ---
# Only needed when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Limits ---
# Maximum agent loop turns before giving up. Prevents runaway loops.
MAX_TURNS=8
