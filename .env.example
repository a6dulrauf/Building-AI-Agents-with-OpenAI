# Copy to .env and fill in. .env is gitignored and must never be committed.

# Which backend to use: ollama (local, no key needed) or openai
LLM_PROVIDER=ollama

# --- Ollama (local) ---
# Must be a model that supports tool calling.
# Tested here: llama3.1 (8B). It calls tools, but not dependably — on the
# reject-then-reconsider flow it sometimes skips the tool entirely or sends
# invalid arguments. See the Approval section of the README.
# Untested suggestions, on the basis that they advertise tool calling:
# qwen2.5, mistral-nemo.
# Small models like llama3.2:1b are unreliable at tool calls and will
# produce confusing failures that look like bugs in your code.
OLLAMA_MODEL=llama3.1

# --- OpenAI ---
# Only needed when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Limits ---
# Maximum agent loop turns before giving up. Prevents runaway loops.
MAX_TURNS=8
